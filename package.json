  "type": "module",
  "homepage": "https://valleyward.app",
  "repository": { "type": "git", "url": "git+https://github.com/lethehaiau/valleyward.git" },
  "description": "VALLEYWARD: a first-person horde survivor at a hilltop keep, with a real-time fluid fire (three.js r186; WebGL2 and WebGPU editions; the fire is a Firewraith module).",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5350 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5351 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "module:check": "tools/gpu-lock.sh node tools/qa/module-check.mjs",
    "e2e": "tools/gpu-lock.sh node tools/qa/e2e.mjs",
    "perf": "tools/gpu-lock.sh node tools/qa/perf.mjs",
    "shots": "tools/gpu-lock.sh node tools/qa/shots.mjs",
    "nights": "node tools/qa/nights.mjs",
    "soak": "tools/gpu-lock.sh node tools/qa/soak.mjs",
    "sbs": "node tools/qa/sbs.mjs"
  },
  "dependencies": {
    "firewraith": "github:lethehaiau/firewraith#98112964af4a4709b3eb978a7aaf5720d372451c",
    "three": "0.186.1"
  },
  "devDependencies": {
    "puppeteer-core": "25.13.0",
    "sharp": "0.35.5",
    "vite": "8.3.4"
  }
}
